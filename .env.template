# =============================================================================
# 加密货币新闻分析工具 (Crypto News Analyzer) — 环境变量模板
# =============================================================================
#
# 使用方法:
#   1. 复制此文件为 .env:  cp .env.template .env
#   2. 取消注释并填入你需要的配置项
#   3. 只配置与你的运行模式相关的变量即可
#
# 支持的运行模式（通过 --mode 命令行参数指定）:
#   analysis-service  — 公网分析服务（HTTP API + Telegram 命令监听）
#   api-only          — 隔离 HTTP API（无调度器、无 Telegram）
#   ingestion         — 私有数据摄取服务（爬虫 + 情报采集 + 每日主题研究）
#   embedding-backfill — Embedding 回填（一次性任务）
#
# =============================================================================
# 一、共享基础配置（所有模式都可能用到）
# =============================================================================

# PostgreSQL / pgvector 连接字符串
# 当 config.jsonc 中 storage.backend=postgres 时必须设置
# 格式: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# 配置文件路径（默认 ./config.jsonc，一般无需修改）
# CONFIG_PATH=./config.jsonc

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# 二、API 服务（analysis-service / api-only 模式）
# =============================================================================

# API 鉴权密钥 — 所有 /analyze、/datasources、/intelligence/* 等 HTTP 端点
# 均需 Bearer Token 认证:  Authorization: Bearer <API_KEY>
API_KEY=your_api_key_here

# API 服务监听地址和端口
API_HOST=0.0.0.0
API_PORT=8080

# =============================================================================
# 三、LLM Provider 凭证（analysis-service / ingestion 模式需要）
# =============================================================================

# 支持的 LLM provider（在 config.jsonc 的 llm_config 中配置具体模型）:
#   kimi         → KIMI_API_KEY
#   grok         → GROK_API_KEY
#   opencode-go  → OPENCODE_API_KEY
#   openai       → OPENAI_API_KEY（用于 semantic_search embedding）
KIMI_API_KEY=your_kimi_api_key_here
GROK_API_KEY=your_grok_api_key_here
OPENCODE_API_KEY=your_opencode_api_key_here

# OpenAI API Key — 语义搜索 (semantic_search) 生成 1536 维 text-embedding-3-small 向量时需要
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# 四、Telegram Bot（analysis-service 模式）
# =============================================================================

# Bot Token — 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 默认推送频道 ID（负数表示频道/群组）
TELEGRAM_CHANNEL_ID=-1001234500123

# Telegram 授权用户 — 允许使用 Bot 命令的用户白名单
# 支持两种格式，逗号分隔，可混合使用:
#   用户 ID（数字）:  123456789
#   用户名（@开头）:   @username
# 示例: 123456789,@user1,987654321,@user2
TELEGRAM_AUTHORIZED_USERS=your_user_id_here

# ---- Telegram 传输模式（webhook vs polling） ----
# TELEGRAM_TRANSPORT_MODE:
#   webhook  — 使用 Webhook 接收消息（推荐用于 Railway 生产环境）
#   polling  — 使用长轮询接收消息（适合本地开发）
# 当设置了任意 Railway 域名变量或 TELEGRAM_WEBHOOK_BASE_URL 时，自动使用 webhook
# TELEGRAM_TRANSPORT_MODE=webhook

# Webhook 路径（默认 /telegram/webhook）
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Webhook 公网基础 URL — 设置后自动使用 webhook 模式
# 会按优先级尝试以下变量:
#   1. TELEGRAM_WEBHOOK_BASE_URL
#   2. RAILWAY_PUBLIC_DOMAIN（Railway 自动注入）
#   3. RAILWAY_STATIC_URL（Railway 自动注入）
#   4. RAILWAY_SERVICE_CRYPTO_NEWS_ANALYSIS_URL（Railway 自动注入）
# TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.com

# Webhook Secret Token — 用于验证来自 Telegram 的请求
# 未设置时自动基于 bot_token 生成 SHA256 哈希
# TELEGRAM_WEBHOOK_SECRET_TOKEN=your_secret_token_here

# =============================================================================
# 五、数据摄取（ingestion 模式）
# =============================================================================

# 爬取循环执行间隔（秒）
# 3600=1小时  21600=6小时  43200=12小时  86400=24小时
EXECUTION_INTERVAL=21300

# 摄取时间窗口（小时）
# 每次爬取时向前回溯的时间范围
TIME_WINDOW_HOURS=6

# =============================================================================
# 六、X/Twitter 抓取（ingestion 模式，启用 X 数据源时需要）
# =============================================================================

# X/Twitter 认证 Cookie
# 需要安装 Bird CLI: npm install -g @laceletho/bird
X_CT0=your_x_ct0_token_here
X_AUTH_TOKEN=your_x_auth_token_here

# =============================================================================
# 七、Bird 抓取器配置（可选，未设置时使用内置默认值）
# =============================================================================

# Bird 可执行文件路径
# BIRD_EXECUTABLE_PATH=bird

# Bird 命令超时（秒），默认 300
# BIRD_TIMEOUT_SECONDS=300

# Bird 最大重试次数，默认 3
# BIRD_MAX_RETRIES=3

# Bird 输出格式 (json/csv)，默认 json
# BIRD_OUTPUT_FORMAT=json

# Bird 请求间隔延迟（秒），默认 1.0
# BIRD_RATE_LIMIT_DELAY=1.0

# Bird 配置文件路径
# BIRD_CONFIG_PATH=~/.bird/config.json

# 是否启用自动重试 (true/false)，默认 true
# BIRD_ENABLE_AUTO_RETRY=true

# Bird 重试延迟（秒），默认 60
# BIRD_RETRY_DELAY_SECONDS=60

# Bird 最大翻页数，默认 3
# BIRD_MAX_PAGE=3

# =============================================================================
# 八、情报采集 — Telegram 群组（ingestion 模式，添加 telegram_group 数据源时需要）
# =============================================================================

# Telethon API 凭证（从 https://my.telegram.org 获取）
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash

# Telethon 字符串会话（用于免登录采集公开群组消息）
# TELEGRAM_STRING_SESSION=your_string_session

# =============================================================================
# 九、情报采集 — V2EX（ingestion 模式，添加 v2ex 数据源时需要）
# =============================================================================

# V2EX Personal Access Token
# 从 https://www.v2ex.com/settings/tokens 获取
# 注意: 环境变量名可通过 config.jsonc 中 v2ex 数据源的 pat_env_var_name 字段自定义
# V2EX_PAT=your_v2ex_pat_here

# =============================================================================
# 十、主题研究 (Topic Research) — 情报生命周期的 LLM 调用参数
# =============================================================================
# 以下环境变量控制主题生命周期中各个 LLM 调用的行为。
# 不设置时使用代码内置默认值。

# ---- 主题 Prompt 生成/修订 ----
# Prompt 生成 LLM 超时（秒），默认 90
# TOPIC_PROMPT_LLM_TIMEOUT_SECONDS=90

# Prompt 生成 LLM 最大重试次数，默认 0（不重试）
# TOPIC_PROMPT_LLM_MAX_RETRIES=0

# ---- 主题发现合并 (/topic_merge) ----
# 合并任务使用的模型名称，默认 deepseek-v4-flash
# TOPIC_MERGE_MODEL=deepseek-v4-flash

# 合并 LLM 请求超时（秒），默认 480（8 分钟）
# TOPIC_MERGE_LLM_TIMEOUT_SECONDS=480

# 合并输出中引文摘要的最大字符数，默认 180
# TOPIC_MERGE_CITATION_SNIPPET_MAX_CHARS=180

# =============================================================================
# 附录: Railway 平台自动注入的环境变量（无需手动设置）
# =============================================================================
# RAILWAY_ENVIRONMENT_NAME  — 当前环境名称（用于检测是否在 Railway 运行）
# RAILWAY_PUBLIC_DOMAIN     — 服务公网域名
# RAILWAY_STATIC_URL        — 静态资源 URL
# RAILWAY_SERVICE_CRYPTO_NEWS_ANALYSIS_URL — analysis 服务的内部 URL
#
# CRYPTO_NEWS_RUNTIME_MODE  — 运行时模式（由 main.py 根据 --mode 参数自动设置）
# =============================================================================
# 使用说明
# =============================================================================
# 本地开发:
#   1. cp .env.template .env
#   2. 按目标运行模式填写对应分区
#   3. 运行:
#      uv run python -m crypto_news_analyzer.main --mode analysis-service
#      uv run python -m crypto_news_analyzer.main --mode api-only
#      uv run python -m crypto_news_analyzer.main --mode ingestion
#
# Railway 部署:
#   - 为 crypto-news-analysis 和 crypto-news-ingestion 两个服务分别配置
#   - 两个服务共用同一个 DATABASE_URL
#   - analysis 服务配置 API/LLM/Telegram 相关变量
#   - ingestion 服务配置 X/Bird/TelegramAPI/V2EX 相关变量
