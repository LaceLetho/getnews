{
  "storage": {
    "retention_days": 30,
    "max_storage_mb": 1000,
    "cleanup_frequency": "daily",
    "backend": "postgres",
    "pgvector_dimensions": 1536
  },
  "llm_config": {
        "model": {
            "provider": "opencode-go",
            "name": "deepseek-v4-pro",
            "options": {
                "thinking_level": "high"
            }
        },
    "fallback_models": [
      {
        "provider": "grok",
        "name": "grok-4-1-fast-reasoning",
        "options": {}
      }
    ],
    "market_model": {
      "provider": "grok",
      "name": "grok-4-1-fast-reasoning",
      "options": {}
    },
    "temperature": 0.6,
    "batch_size": 200,
    "market_prompt_path": "./prompts/market_summary_prompt.md",
    "analysis_prompt_path": "./prompts/analysis_prompt.md",
    "min_weight_score": 50,
    "cache_ttl_minutes": 240,
    "cached_messages_hours": 24,
    "enable_debug_logging": true
  },
  "intelligence_collection": {
    "extraction": {
      // Topic prompt extraction model (raw messages -> topic evidence candidates)
      "provider": "opencode-go",
      "model": "deepseek-v4-pro",
      "thinking_level": "high",
      "max_tokens": 300000,
      "batch_size": 200
    },
    "topic_research": {
      // Topic research scheduler: daily batch/chunk limits and LLM model config.
      "enabled": true,
      "daily": true,
      "raw_item_limit": 200,
      "max_chunk_chars": 50000,
      "model": {
        "provider": "opencode-go",
        "name": "deepseek-v4-pro",
        "options": {}
      }
    },
    "collection": {
      // Source crawl interval. Topic research runs daily on the UTC schedule below.
      "interval_minutes": 60,
      // Topic and raw message retention in days (both default to 180).
      "ttl_days": 180,
      "raw_message_retention_days": 180,
      "backfill_hours": 24,
      "confidence_threshold": 0.6,
      "daily_topic_research_enabled": true,
      "daily_topic_research_time_utc": "03:00"
    },
    "topic_enrichment": {
      // Topic research and merge model configuration.
      "enabled": true,
      "provider": "opencode-go",
      "model": "deepseek-v4-pro",
      "thinking_level": "high",
      "min_new_evidence": 3,
      "max_evidence_per_run": 15,
      "initial_max_evidence": 20,
      "raw_text_max_chars": 1000,
      "min_enrich_interval_hours": 24,
      "entry_topic_auto_link_threshold": 0.78,
      "convergence_similarity_threshold": 0.88,
      "max_convergence_pairs_per_run": 5
    },
    "discovery_novelty": {
      "enabled": true,
      "similar_threshold": 0.82,
      "duplicate_like_threshold": 0.90
    },
    "sources": {}
  },
  "telegram_commands": {
    "enabled": true,
    "execution_timeout_minutes": 30,
    "max_concurrent_executions": 1,
    "command_rate_limit": {
      "max_commands_per_hour": 120,
      "cooldown_seconds": 1
    }
  },
  "semantic_search": {
    // 用户原始检索词允许的最大字符数；过长会直接拒绝
    "query_max_chars": 300,
    // [已禁用] LLM 查询规划器默认关闭。仅在 query_planning_enabled: true 时，LLM 将主题拆成多个子查询并生成关键词
    "max_subqueries": 4,
    // 每个子查询最多从 pgvector 召回多少条候选新闻
    "per_subquery_limit": 200,
    // 所有向量召回和关键词召回合并去重，最多保留前多少条新闻进入最终总结
    "max_retained_items": 500,
    // 总结阶段每批送给模型处理的新闻条数；这里跟随 llm_config.batch_size
    "synthesis_batch_size": 100,
    // 每条新闻进入摘要 prompt 的正文最大字符数，避免单条消息过长触发代理端 1000
    "synthesis_item_content_max_chars": 1000,
    // 生成向量所用的 OpenAI embedding 模型
    "embedding_model": "text-embedding-3-small",
    // embedding 向量维度；必须与 storage.pgvector_dimensions 保持一致
    "embedding_dimensions": 1536,
    // 是否启用关键词补召回（本地确定性试探，不含 LLM 生成的关键词）
    "keyword_search_enabled": true,
    // 所有关键词合并在一次 SQL 里最多返回数目
    "keyword_search_limit": 800,
    // 本地确定性扩展后最多保留多少个关键词片段；LLM 关键词仅在 query_planning_enabled: true 时生效
    "max_keyword_queries": 16,
    // 语义搜索总开关；关闭后 HTTP/Telegram 语义搜索都不可用
    "enabled": true,
    // 是否启用 LLM 查询规划器 (子查询分解 + 关键词生成)。默认 false，直接使用原始查询嵌入向量
    "query_planning_enabled": false
  },
  "analysis_config": {
    "max_analysis_window_hours": 24,
    "min_analysis_window_hours": 1
  }
}
